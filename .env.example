PORT=3000
HOST=0.0.0.0
DATABASE_PATH=/data/private-subscription-manager.db
ADMIN_BASE_URL=https://panel.example.com
# Bootstrap default only. After first start, Settings -> Subscription Domain in SQLite is authoritative.
SUBSCRIPTION_BASE_URL=https://sub.example.com
COOKIE_SECURE=true
TRUST_PROXY=1
# Generate: openssl rand -hex 32. Keep outside Git. Losing this key loses decryptable URL tokens.
APP_MASTER_KEY=
# Used only by root CLI export/restore; do not keep this in the runtime env file.
# BACKUP_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
