#!/usr/bin/env bash
set -Eeuo pipefail

readonly DXDY_MANAGER_VERSION="0.3.3"
CONFIG_DIR="${DXDY_CONFIG_DIR:-/etc/dx-dy}"
CONFIG_FILE="$CONFIG_DIR/install.conf"
MANAGER_PATH="${DXDY_MANAGER_PATH:-/usr/local/bin/dx-dy}"
TEMP_DIRS=()

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
valid_hostname() {
  [[ ${#1} -le 253 && "$1" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]
}
require_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || [[ "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 && "$CONFIG_DIR" == /tmp/dxdy-ops-test-*/* ]] || die "Please run as root or sudo."
}
cleanup_manager() { local d; for d in "${TEMP_DIRS[@]}"; do [[ "$d" == /tmp/* ]] && rm -rf -- "$d"; done; }
trap cleanup_manager EXIT

load_instance() {
  [[ -f "$CONFIG_FILE" ]] || die "dx-dy native installation not found."
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  [[ "${DXDY_RELEASE_MODEL:-}" == native-systemd ]] || die "Legacy Docker install detected. Run the 0.3.3 installer to migrate."
  : "${DXDY_INSTALL_ROOT:?}" "${DXDY_DATA_DIR:?}" "${DXDY_BACKUP_DIR:?}" "${DXDY_INTERNAL_PORT:?}"
  ENV_FILE="$CONFIG_DIR/dx-dy.env"
  CURRENT_LINK="$DXDY_INSTALL_ROOT/current"
  NODE="$CURRENT_LINK/runtime/bin/node"
  APP="$CURRENT_LINK/app"
  SERVICE="${DXDY_SERVICE:-dx-dy.service}"
  SYSTEMD_UNIT_PATH="${DXDY_SYSTEMD_UNIT_PATH:-/etc/systemd/system/dx-dy.service}"
  CADDY_IMPORT="${DXDY_CADDY_IMPORT:-/etc/caddy/dx-dy.caddy}"
  CADDY_MAIN="${DXDY_CADDYFILE:-${CADDY_IMPORT%/*}/Caddyfile}"
  DATABASE="$DXDY_DATA_DIR/dx-dy.db"
  UPDATE_STATE_FILE="$CONFIG_DIR/update-state.json"
  [[ -L "$CURRENT_LINK" && -x "$NODE" && -f "$ENV_FILE" ]] || die "Native installation layout is incomplete."
}

run_cli() {
  local script="$1"; shift
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
  if [[ "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 ]]; then (cd "$APP" && "$NODE" "$APP/dist/$script" "$@")
  else (cd "$APP" && runuser -u dx-dy -- "$NODE" "$APP/dist/$script" "$@"); fi
}

run_cli_root() {
  local script="$1"; shift
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
  (cd "$APP" && "$NODE" "$APP/dist/$script" "$@")
}

health() { curl -fsS --max-time 10 "http://127.0.0.1:$DXDY_INTERNAL_PORT/health"; }
wait_health() { for _ in {1..45}; do health >/dev/null 2>&1 && return; sleep 2; done; return 1; }
service_state() {
  local state
  state="$(systemctl is-active "$1" 2>/dev/null || true)"
  printf '%s' "${state:-inactive}"
}

cmd_status() {
  load_instance
  local health_json tls_state current disk
  health_json="$(health 2>/dev/null || printf unavailable)"
  current="$(readlink -f "$CURRENT_LINK" 2>/dev/null || printf unavailable)"
  disk="$(du -sh "$DXDY_INSTALL_ROOT" "$DXDY_DATA_DIR" "$DXDY_BACKUP_DIR" 2>/dev/null | awk '{printf "%s=%s ",$2,$1}')"
  if curl -fsSI --max-time 10 "https://$DXDY_ADMIN_DOMAIN/health" >/dev/null 2>&1; then tls_state=ready; else tls_state=pending-or-unreachable; fi
  printf '%s\n' \
    "dx-dy $DXDY_VERSION" \
    "Release model: native-systemd" \
    "Application service: $(service_state "$SERVICE")" \
    "Caddy service: $(service_state caddy.service)" \
    "Health: $health_json" \
    "Admin: https://$DXDY_ADMIN_DOMAIN" \
    "Subscription: https://$DXDY_SUBSCRIPTION_DOMAIN" \
    "Internal endpoint: 127.0.0.1:$DXDY_INTERNAL_PORT" \
    "Database: $DATABASE" \
    "Install root: $DXDY_INSTALL_ROOT" \
    "Current release: $current" \
    "Caddy TLS: $tls_state" \
    "Disk usage: ${disk:-unavailable}"
}

cmd_start() { load_instance; systemctl start "$SERVICE"; systemctl start caddy.service; wait_health || die "Application did not become healthy."; }
cmd_stop() { load_instance; systemctl stop "$SERVICE"; }
cmd_restart() { load_instance; systemctl restart "$SERVICE"; wait_health || die "Application did not become healthy."; printf 'dx-dy restarted and healthy.\n'; }

read_confirmed_secret() {
  local prompt="$1" first second
  read -r -s -p "$prompt: " first; printf '\n' >&2
  read -r -s -p "Confirm $prompt: " second; printf '\n' >&2
  [[ "$first" == "$second" ]] || die "Values do not match."
  [[ ${#first} -ge 12 ]] || die "Password must be at least 12 characters."
  REPLY="$first"
}

cmd_admin() {
  load_instance
  case "${1:-}" in
    reset-password) read_confirmed_secret "new administrator password"; printf '%s' "$REPLY" | run_cli admin-cli.mjs reset-password; unset REPLY ;;
    change-username)
      local username; read -r -p "New administrator username: " username
      [[ "$username" =~ ^[A-Za-z0-9._-]{1,100}$ ]] || die "Invalid username."
      printf '%s' "$username" | run_cli admin-cli.mjs change-username
      ;;
    *) die "Usage: dx-dy admin <reset-password|change-username>" ;;
  esac
}

backup_target() {
  local extension="$1"
  mkdir -p "$DXDY_BACKUP_DIR"; chmod 0750 "$DXDY_BACKUP_DIR"
  printf '%s/dx-dy-%s-%s.%s' "$DXDY_BACKUP_DIR" "$DXDY_VERSION" "$(date -u +%Y%m%d-%H%M%SZ)" "$extension"
}
report_backup() {
  local file="$1"; [[ -s "$file" ]] || die "Backup was not created: $file"
  chmod 0600 "$file"
  printf 'Backup: %s\nSize: %s bytes\nSHA-256: %s\n' "$file" "$(stat -c %s "$file")" "$(sha256sum "$file" | cut -d' ' -f1)"
}
cmd_backup() {
  load_instance
  local kind="${1:-db}" target
  case "$kind" in
    db) target="$(backup_target db)"; run_cli database.mjs backup "$target" ;;
    full) target="$(backup_target psmbackup)"; read_confirmed_secret "full migration backup password"; printf '%s' "$REPLY" | BACKUP_PASSWORD_STDIN=true run_cli database.mjs bundle "$target"; unset REPLY ;;
    *) die "Usage: dx-dy backup <db|full>" ;;
  esac
  report_backup "$target"
}

cmd_restore() {
  require_root; load_instance
  local source="${1:-}" result=0
  [[ -n "$source" ]] || read -r -p "Backup path: " source
  [[ "$source" = /* && -f "$source" && "$source" == "$DXDY_BACKUP_DIR"/* ]] || die "Use an existing backup inside $DXDY_BACKUP_DIR."
  if [[ "${DXDY_ALLOW_TEST_PATHS:-0}" != 1 ]]; then chown dx-dy:dx-dy "$source"; fi
  cmd_backup db >/dev/null
  systemctl stop "$SERVICE"
  if [[ "$source" == *.psmbackup ]]; then
    read_confirmed_secret "full migration backup password"
    printf '%s' "$REPLY" | BACKUP_PASSWORD_STDIN=true INSTANCE_ENV_FILE="$ENV_FILE" run_cli_root database.mjs restore "$source" || result=$?
    unset REPLY
  else run_cli database.mjs restore "$source" || result=$?; fi
  chown -R -h dx-dy:dx-dy -- "$DXDY_DATA_DIR"
  if [[ "${DXDY_ALLOW_TEST_PATHS:-0}" != 1 ]]; then chown root:root -- "$ENV_FILE"; fi
  chmod 0600 "$DATABASE" "$ENV_FILE"
  systemctl start "$SERVICE"
  [[ $result -eq 0 ]] || die "Restore failed; the pre-restore snapshot remains available."
  wait_health || die "Restore completed but health check failed."
  printf 'Restore completed and health check passed: %s\n' "$source"
}

render_caddy() {
  render_caddy_from_release "$CURRENT_LINK" "$1" "$2" "$3"
}
render_caddy_from_release() {
  local release="$1" admin="$2" subscription="$3" output="$4" template
  if [[ "$admin" == "$subscription" ]]; then template="$release/Caddyfile.single"; else template="$release/Caddyfile.dual"; fi
  [[ -f "$template" ]] || return 1
  sed -e "s/__ADMIN_DOMAIN__/$admin/g" -e "s/__SUBSCRIPTION_DOMAIN__/$subscription/g" -e "s/__INTERNAL_PORT__/$DXDY_INTERNAL_PORT/g" "$template" >"$output"
}
validate_caddy_candidate() {
  local candidate="$1" staging import_line count combined
  caddy validate --config "$candidate" --adapter caddyfile >/dev/null || return 1
  [[ -f "$CADDY_MAIN" ]] || return 1
  import_line="import $CADDY_IMPORT"
  count="$(grep -Fxc "$import_line" "$CADDY_MAIN" || true)"
  [[ "$count" == 1 ]] || return 1
  staging="$(mktemp -d)" || return 1
  TEMP_DIRS+=("$staging")
  combined="$staging/Caddyfile"
  awk -v line="$import_line" -v candidate="$candidate" '$0 == line { print "import " candidate; next } { print }' "$CADDY_MAIN" >"$combined"
  caddy validate --config "$combined" --adapter caddyfile >/dev/null
}
caddy_health() { curl -fsS --max-time 10 "https://$1/health"; }
wait_caddy_health() {
  local admin="$DXDY_ADMIN_DOMAIN" subscription="$DXDY_SUBSCRIPTION_DOMAIN" attempts=15 i
  [[ "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 ]] && attempts=1
  for ((i=0; i<attempts; i++)); do
    if caddy_health "$admin" >/dev/null 2>&1 && { [[ "$subscription" == "$admin" ]] || caddy_health "$subscription" >/dev/null 2>&1; }; then return 0; fi
    sleep 2
  done
  return 1
}
backup_caddy_fragment() {
  local directory target
  [[ -f "$CADDY_IMPORT" ]] || return 1
  directory="$CONFIG_DIR/caddy-backups"
  install -d -m 0700 "$directory"
  target="$(mktemp "$directory/dx-dy.caddy.$(date -u +%Y%m%d-%H%M%SZ).XXXXXX.bak")" || return 1
  cp -a "$CADDY_IMPORT" "$target" || return 1
  chmod 0600 "$target"
  printf '%s' "$target"
}
restore_caddy_fragment() {
  local backup="$1" expected="$2" staged
  [[ -f "$backup" && "$expected" =~ ^[a-f0-9]{64}$ ]] || return 1
  [[ "$(sha256sum "$backup" | cut -d' ' -f1)" == "$expected" ]] || return 1
  staged="${CADDY_IMPORT}.rollback.$$"
  install -m 0644 "$backup" "$staged" || return 1
  mv -Tf "$staged" "$CADDY_IMPORT" || return 1
  caddy validate --config "$CADDY_MAIN" --adapter caddyfile >/dev/null || return 1
  systemctl reload caddy.service || return 1
  wait_caddy_health
}
reconcile_caddy() {
  local release="$1" backup="$2" backup_fingerprint="$3" staging candidate staged changed=1
  staging="$(mktemp -d)" || return 1
  TEMP_DIRS+=("$staging")
  candidate="$staging/dx-dy.caddy"
  render_caddy_from_release "$release" "$DXDY_ADMIN_DOMAIN" "$DXDY_SUBSCRIPTION_DOMAIN" "$candidate" || return 1
  validate_caddy_candidate "$candidate" || return 1
  if cmp -s "$candidate" "$CADDY_IMPORT"; then changed=0; else
    staged="${CADDY_IMPORT}.next.$$"
    install -m 0644 "$candidate" "$staged" || return 1
    if [[ "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 && "${DXDY_TEST_INTERRUPT_BEFORE_CADDY_RENAME:-0}" == 1 ]]; then
      rm -f "$staged"
      return 1
    fi
    mv -Tf "$staged" "$CADDY_IMPORT" || return 1
  fi
  if ! systemctl reload caddy.service || ! wait_caddy_health; then
    if [[ $changed -eq 1 ]]; then
      restore_caddy_fragment "$backup" "$backup_fingerprint" || die "ROLLBACK: FAIL; previous Caddy configuration could not be restored."
    fi
    return 1
  fi
  if [[ $changed -eq 1 ]]; then printf 'Caddy configuration reconciled and healthy.\n'; else printf 'Caddy configuration already current and healthy.\n'; fi
}
set_config_value() {
  local file="$1" key="$2" value="$3" temp
  temp="$(mktemp "${file}.XXXXXX")"
  awk -v key="$key" -v value="$value" 'BEGIN{found=0}$0~"^"key"="{print key"="value;found=1;next}{print}END{if(!found)print key"="value}' "$file" >"$temp"
  chmod --reference="$file" "$temp"; mv -f "$temp" "$file"
}

cmd_domain() {
  require_root; load_instance
  local action="${1:-menu}" admin="$DXDY_ADMIN_DOMAIN" subscription="$DXDY_SUBSCRIPTION_DOMAIN" temp old
  case "$action" in
    set-admin) admin="${2:-}" ;; set-subscription) subscription="${2:-}" ;; single) subscription="$admin" ;; dual) subscription="${2:-}" ;; check) cmd_doctor; return ;;
    menu)
      printf 'Current Admin: https://%s\nCurrent Subscription: https://%s\n1. Change Admin Domain\n2. Change Subscription Domain\n3. Single-domain mode\n4. Dual-domain mode\n0. Return\n' "$admin" "$subscription"
      local choice; read -r -p "Choice: " choice
      case "$choice" in 1) read -r -p "Admin hostname: " admin ;; 2) read -r -p "Subscription hostname: " subscription ;; 3) subscription="$admin" ;; 4) read -r -p "Subscription hostname: " subscription ;; 0) return ;; *) die "Invalid choice." ;; esac
      ;;
    *) die "Usage: dx-dy domain [set-admin HOST|set-subscription HOST|single|dual HOST|check]" ;;
  esac
  if ! valid_hostname "$admin" || ! valid_hostname "$subscription"; then die "Invalid hostname."; fi
  temp="$(mktemp -d)"; TEMP_DIRS+=("$temp"); render_caddy "$admin" "$subscription" "$temp/candidate"; old="$temp/old"; cp "$CADDY_IMPORT" "$old"
  caddy validate --config "$temp/candidate" --adapter caddyfile >/dev/null
  install -m 0644 "$temp/candidate" "$CADDY_IMPORT"
  set_config_value "$CONFIG_FILE" DXDY_ADMIN_DOMAIN "$admin"; set_config_value "$CONFIG_FILE" DXDY_SUBSCRIPTION_DOMAIN "$subscription"
  set_config_value "$ENV_FILE" ADMIN_BASE_URL "https://$admin"; set_config_value "$ENV_FILE" SUBSCRIPTION_BASE_URL "https://$subscription"
  if ! printf '%s' "https://$subscription" | run_cli domain-cli.mjs set-subscription || ! systemctl restart "$SERVICE" || ! systemctl reload caddy.service || ! wait_health; then
    cp "$old" "$CADDY_IMPORT"; set_config_value "$CONFIG_FILE" DXDY_ADMIN_DOMAIN "$DXDY_ADMIN_DOMAIN"; set_config_value "$CONFIG_FILE" DXDY_SUBSCRIPTION_DOMAIN "$DXDY_SUBSCRIPTION_DOMAIN"
    set_config_value "$ENV_FILE" ADMIN_BASE_URL "https://$DXDY_ADMIN_DOMAIN"; set_config_value "$ENV_FILE" SUBSCRIPTION_BASE_URL "https://$DXDY_SUBSCRIPTION_DOMAIN"
    printf '%s' "https://$DXDY_SUBSCRIPTION_DOMAIN" | run_cli domain-cli.mjs set-subscription || true; systemctl restart "$SERVICE" || true; systemctl reload caddy.service || true
    die "Domain change failed; previous configuration restored."
  fi
  printf 'Domains updated. Admin: https://%s Subscription: https://%s\n' "$admin" "$subscription"
}

check_line() { printf '%-5s %s\n' "$1" "$2"; }
cmd_doctor() {
  load_instance
  if [[ -d /run/systemd/system || "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 ]]; then check_line PASS "systemd"; else check_line FAIL "systemd"; fi
  if [[ "$(service_state "$SERVICE")" == active ]]; then check_line PASS "$SERVICE active"; else check_line FAIL "$SERVICE inactive"; fi
  if [[ "$(service_state caddy.service)" == active ]]; then check_line PASS "Caddy active"; else check_line WARN "Caddy inactive"; fi
  if health >/dev/null 2>&1; then check_line PASS "Application health"; else check_line FAIL "Application health"; fi
  if run_cli database.mjs check >/dev/null 2>&1; then check_line PASS "Database integrity and foreign keys"; else check_line FAIL "Database integrity and foreign keys"; fi
  if [[ -L "$CURRENT_LINK" && -f "$CURRENT_LINK/RELEASE.json" ]]; then check_line PASS "Current release symlink and manifest"; else check_line FAIL "Current release layout"; fi
  if [[ "$(stat -c %a "$ENV_FILE")" == 600 ]]; then check_line PASS "Secret environment permissions"; else check_line FAIL "Secret environment permissions"; fi
  if ss -H -ltn "sport = :$DXDY_INTERNAL_PORT" 2>/dev/null | grep -q '127.0.0.1'; then check_line PASS "Local-only application listener"; else check_line WARN "Local listener not observed"; fi
  local host; for host in "$DXDY_ADMIN_DOMAIN" "$DXDY_SUBSCRIPTION_DOMAIN"; do if getent ahosts "$host" >/dev/null 2>&1; then check_line PASS "DNS $host"; else check_line WARN "DNS $host unresolved"; fi; done
  if curl -fsSI --max-time 10 "https://$DXDY_ADMIN_DOMAIN/health" >/dev/null 2>&1; then check_line PASS "TLS/HTTPS"; else check_line WARN "TLS/HTTPS pending or unreachable"; fi
  df -Pk "$DXDY_INSTALL_ROOT" | awk 'NR==2{if($4>=1048576)print "PASS  Disk space";else print "WARN  Less than 1 GiB free"}'
}

cmd_logs() {
  load_instance
  local service="${1:-app}" lines="${2:-200}" follow=()
  [[ "$lines" =~ ^[1-9][0-9]{0,4}$ ]] || die "Line count must be 1-99999."
  [[ "$service" == follow ]] && { service=app; follow=(-f); }
  case "$service" in app) journalctl -u "$SERVICE" -n "$lines" "${follow[@]}" ;; caddy) journalctl -u caddy.service -n "$lines" "${follow[@]}" ;; all) journalctl -u "$SERVICE" -u caddy.service -n "$lines" ;; *) die "Usage: dx-dy logs [app|caddy|all|follow] [lines]" ;; esac
}

version_lt() { [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" != "$2" ]]; }
fetch_update_asset() {
  local url="$1" name="$2" target="$3"
  if [[ -n "${DXDY_UPDATE_MOCK_DIR:-}" ]]; then
    [[ "$DXDY_UPDATE_MOCK_DIR" == /tmp/dxdy-ops-test-* ]] || die "Unsafe update mock directory."
    [[ "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 || "${DXDY_LOCAL_ACCEPTANCE_ASSETS:-0}" == 1 ]] || die "Local update assets are disabled."
    cp "$DXDY_UPDATE_MOCK_DIR/$name" "$target"
  else curl -fsSL --proto '=https' --tlsv1.2 "$url/$name" -o "$target"; fi
}

prune_releases() {
  local current previous dir
  current="$(readlink -f "$CURRENT_LINK")"
  previous="$(sed -n 's/^DXDY_PREVIOUS_RELEASE=//p' "$CONFIG_FILE" | head -1)"
  while IFS= read -r dir; do [[ "$dir" == "$current" || "$dir" == "$previous" ]] || rm -rf -- "$dir"; done < <(find "$DXDY_INSTALL_ROOT/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | awk 'NR>3{sub(/^[^ ]+ /,"");print}')
}

database_fingerprint() {
  local file="$1" result program
  # shellcheck disable=SC2016
  program='
    import { createHash } from "node:crypto";
    import { DatabaseSync } from "node:sqlite";
    const database = new DatabaseSync(process.argv[1], { readOnly: true });
    const hash = createHash("sha256");
    const tables = database.prepare("SELECT name,sql FROM sqlite_master WHERE type=? AND name NOT LIKE ? ORDER BY name").all("table", "sqlite_%");
    for (const table of tables) {
      hash.update(JSON.stringify([table.name, table.sql]));
      const quoted = `"${String(table.name).replaceAll("\"", "\"\"")}"`;
      if (table.name !== "admin_sessions")
        for (const row of database.prepare(`SELECT * FROM ${quoted} ORDER BY rowid`).all())
          hash.update(JSON.stringify(row, (_key, value) => typeof value === "bigint" ? value.toString() : value));
    }
    database.close();
    process.stdout.write(hash.digest("hex"));
  '
  if [[ "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 ]]; then
    result="$( (cd "$APP" || exit; "$NODE" --input-type=module -e "$program" "$file") 2>/dev/null || true)"
    if [[ "$result" =~ ^[a-f0-9]{64}$ ]]; then printf '%s' "$result"; else sha256sum "$file" | cut -d' ' -f1; fi
  else
    (cd "$APP" && runuser -u dx-dy -- "$NODE" --input-type=module -e "$program" "$file")
  fi
}

write_update_state() {
  local phase="$1" old_release="$2" new_release="$3" backup="$4" backup_fingerprint="$5" old_version="$6" new_version="$7" old_previous="$8" caddy_backup="$9" caddy_fingerprint="${10}" temp
  temp="$(mktemp "$CONFIG_DIR/update-state.json.XXXXXX")"
  jq -n --arg phase "$phase" --arg old_release "$old_release" --arg new_release "$new_release" --arg backup "$backup" --arg backup_fingerprint "$backup_fingerprint" --arg old_version "$old_version" --arg new_version "$new_version" --arg old_previous "$old_previous" --arg caddy_backup "$caddy_backup" --arg caddy_fingerprint "$caddy_fingerprint" \
    '{format:2,phase:$phase,old_release:$old_release,new_release:$new_release,backup:$backup,backup_fingerprint:$backup_fingerprint,old_version:$old_version,new_version:$new_version,old_previous:$old_previous,caddy_backup:$caddy_backup,caddy_fingerprint:$caddy_fingerprint}' >"$temp"
  chmod 0600 "$temp"; mv -Tf "$temp" "$UPDATE_STATE_FILE"
}

recover_interrupted_update() {
  UPDATE_RECOVERY_ACTION=none
  [[ -f "$UPDATE_STATE_FILE" ]] || return 0
  local phase old_release new_release backup backup_fingerprint old_version new_version old_previous current caddy_backup caddy_fingerprint
  phase="$(jq -er '.phase' "$UPDATE_STATE_FILE")" || die "Interrupted update state is invalid."
  old_release="$(jq -er '.old_release' "$UPDATE_STATE_FILE")"; new_release="$(jq -er '.new_release' "$UPDATE_STATE_FILE")"
  backup="$(jq -er '.backup' "$UPDATE_STATE_FILE")"; old_version="$(jq -er '.old_version' "$UPDATE_STATE_FILE")"
  backup_fingerprint="$(jq -er '.backup_fingerprint' "$UPDATE_STATE_FILE")"
  new_version="$(jq -er '.new_version' "$UPDATE_STATE_FILE")"; old_previous="$(jq -er '.old_previous' "$UPDATE_STATE_FILE")"
  caddy_backup="$(jq -r '.caddy_backup // ""' "$UPDATE_STATE_FILE")"; caddy_fingerprint="$(jq -r '.caddy_fingerprint // ""' "$UPDATE_STATE_FILE")"
  [[ "$phase" == prepared || "$phase" == switched ]] || die "Interrupted update phase is invalid."
  [[ "$old_release" == "$DXDY_INSTALL_ROOT/releases/"* && -d "$old_release" ]] || die "Interrupted update old release is invalid."
  [[ "$new_release" == "$DXDY_INSTALL_ROOT/releases/"* && -d "$new_release" ]] || die "Interrupted update new release is invalid."
  [[ "$backup" == "$DXDY_BACKUP_DIR/"* && -s "$backup" ]] || die "Interrupted update backup is invalid."
  [[ "$backup_fingerprint" =~ ^[a-f0-9]{64}$ ]] || die "Interrupted update backup fingerprint is invalid."
  [[ "$old_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$new_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Interrupted update versions are invalid."
  current="$(readlink -f "$CURRENT_LINK")"
  if [[ "$phase" == prepared && "$current" == "$old_release" ]]; then
    rm -f "$UPDATE_STATE_FILE"; warn "Discarded an interrupted update before release activation."; return 0
  fi
  if [[ "$current" == "$new_release" ]] && health >/dev/null 2>&1; then
    if [[ -z "$caddy_backup" ]]; then
      caddy_backup="$(backup_caddy_fragment)" || die "Interrupted update Caddy backup failed."
      caddy_fingerprint="$(sha256sum "$caddy_backup" | cut -d' ' -f1)"
    fi
    if reconcile_caddy "$new_release" "$caddy_backup" "$caddy_fingerprint"; then
      rm -f "$UPDATE_STATE_FILE"; warn "Finalized an interrupted update after verified application and Caddy health."; return 0
    fi
  fi
  warn "Recovering an interrupted update with the previous release."
  systemctl stop "$SERVICE" || true
  ln -sfn "$old_release" "$DXDY_INSTALL_ROOT/current.next"; mv -Tf "$DXDY_INSTALL_ROOT/current.next" "$CURRENT_LINK"
  set_config_value "$CONFIG_FILE" DXDY_VERSION "$old_version"; set_config_value "$CONFIG_FILE" DXDY_PREVIOUS_RELEASE "$old_previous"
  install -m 0644 "$old_release/dx-dy.service" "$SYSTEMD_UNIT_PATH"; systemctl daemon-reload
  if ! restore_update_backup "$backup" "$backup_fingerprint"; then die "ROLLBACK: FAIL; interrupted update database recovery failed. Application remains stopped."; fi
  if [[ -n "$caddy_backup" ]] && ! restore_caddy_fragment "$caddy_backup" "$caddy_fingerprint"; then die "ROLLBACK: FAIL; interrupted update Caddy recovery failed. Application remains stopped."; fi
  if ! systemctl start "$SERVICE" || ! wait_health; then die "ROLLBACK: FAIL; interrupted update restored data but the previous application is not healthy."; fi
  rm -f "$UPDATE_STATE_FILE"; UPDATE_RECOVERY_ACTION=rollback
  warn "ROLLBACK: PASS; interrupted update restored the previous release and database. Run update again to retry."
}

restore_update_backup() {
  local source="$1" expected_fingerprint="$2" staging candidate actual_fingerprint previous file restore_file moved=()
  staging="$(mktemp -d "$DXDY_DATA_DIR/.update-rollback-XXXXXX")" || return 1
  candidate="$staging/restored.db"
  if [[ "${DXDY_ALLOW_TEST_PATHS:-0}" != 1 ]]; then
    chown dx-dy:dx-dy "$staging" || return 1
  fi
  # The previous application cannot inspect a database already migrated by the
  # failed update. Restore into an absent destination with its own CLI instead;
  # this retains schema validation, token verification and the old migrations.
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
  if [[ "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 ]]; then
    (cd "$APP" && DATABASE_PATH="$candidate" "$NODE" "$APP/dist/database.mjs" restore "$source") || return 1
  else
    (cd "$APP" && runuser -u dx-dy -- env DATABASE_PATH="$candidate" "$NODE" "$APP/dist/database.mjs" restore "$source") || return 1
  fi
  [[ -s "$candidate" ]] || return 1
  actual_fingerprint="$(database_fingerprint "$candidate")" || return 1
  if [[ "$actual_fingerprint" != "$expected_fingerprint" ]]; then
    warn "Rollback database fingerprint mismatch (expected $expected_fingerprint, restored $actual_fingerprint)."
    return 1
  fi
  # All writers are stopped. Retain the failed database and its sidecars for
  # diagnosis, then atomically activate the validated old-schema database.
  for file in "$DATABASE" "$DATABASE-wal" "$DATABASE-shm"; do
    if [[ -e "$file" ]]; then
      previous="$staging/failed-$(basename "$file")"
      if ! mv -- "$file" "$previous"; then
        for restore_file in "${moved[@]}"; do mv -- "$staging/failed-$(basename "$restore_file")" "$restore_file" || true; done
        return 1
      fi
      moved+=("$file")
    fi
  done
  if ! mv -- "$candidate" "$DATABASE"; then
    for file in "${moved[@]}"; do mv -- "$staging/failed-$(basename "$file")" "$file" || true; done
    return 1
  fi
  chmod 0600 "$DATABASE" || return 1
}

cmd_update() {
  require_root; load_instance
  exec 9>"$CONFIG_DIR/update.lock"; flock -n 9 || die "Another update is already running."
  if [[ "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 && -n "${DXDY_TEST_LOCK_HOLD_SECONDS:-}" ]]; then sleep "$DXDY_TEST_LOCK_HOLD_SECONDS"; fi
  recover_interrupted_update
  load_instance
  [[ "${UPDATE_RECOVERY_ACTION:-none}" != rollback ]] || return 0
  [[ "$DXDY_REPOSITORY" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "Invalid repository coordinate."
  local temp api latest base artifact expected actual old_release new_release backup backup_fingerprint result=0 old_version old_previous caddy_backup caddy_fingerprint
  temp="$(mktemp -d)"; TEMP_DIRS+=("$temp")
  api="https://api.github.com/repos/$DXDY_REPOSITORY/releases/latest"
  if [[ -n "${DXDY_UPDATE_MOCK_DIR:-}" ]]; then cp "$DXDY_UPDATE_MOCK_DIR/release.json" "$temp/release.json"; else curl -fsSL --proto '=https' --tlsv1.2 "$api" -o "$temp/release.json"; fi
  latest="$(jq -er '.tag_name|sub("^v";"")' "$temp/release.json")"; [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Invalid latest version."
  printf 'Current: %s\nLatest: %s\n' "$DXDY_VERSION" "$latest"; version_lt "$DXDY_VERSION" "$latest" || { printf 'Already current.\n'; return; }
  [[ "${DXDY_UPDATE_YES:-0}" == 1 ]] || { local confirm; read -r -p "Update now? [y/N] " confirm; [[ "$confirm" =~ ^[Yy]$ ]] || return; }
  base="https://github.com/$DXDY_REPOSITORY/releases/download/v$latest"; fetch_update_asset "$base" release-manifest.json "$temp/manifest.json"
  jq -e --arg v "$latest" --arg a "$DXDY_ARCH" --arg r "$DXDY_REPOSITORY" '.version==$v and .repository==$r and .release_model=="native-systemd" and (.architectures|index($a)) and (.git_commit|test("^[a-f0-9]{40}$"))' "$temp/manifest.json" >/dev/null || die "Release manifest validation failed."
  artifact="dx-dy-$latest-linux-$DXDY_ARCH.tar.gz"; fetch_update_asset "$base" "$artifact" "$temp/$artifact"
  expected="$(jq -er --arg n "$artifact" '.artifacts[]|select(.name==$n)|.sha256' "$temp/manifest.json")"; actual="$(sha256sum "$temp/$artifact"|cut -d' ' -f1)"; [[ "$expected" == "$actual" ]] || die "Artifact checksum failed."
  fetch_update_asset "$base" dx-dy "$temp/dx-dy"; expected="$(jq -er '.manager_sha256' "$temp/manifest.json")"; actual="$(sha256sum "$temp/dx-dy"|cut -d' ' -f1)"; [[ "$expected" == "$actual" ]] || die "Manager checksum failed."
  backup="$(backup_target db)"; run_cli database.mjs backup "$backup" >/dev/null
  backup_fingerprint="$(database_fingerprint "$backup")" || die "Backup fingerprint failed."
  [[ "$backup_fingerprint" =~ ^[a-f0-9]{64}$ ]] || die "Backup fingerprint failed."
  caddy_backup="$(backup_caddy_fragment)" || die "Caddy configuration backup failed."
  caddy_fingerprint="$(sha256sum "$caddy_backup" | cut -d' ' -f1)"
  [[ "$caddy_fingerprint" =~ ^[a-f0-9]{64}$ ]] || die "Caddy configuration backup fingerprint failed."
  old_release="$(readlink -f "$CURRENT_LINK")"; old_version="$DXDY_VERSION"; old_previous="${DXDY_PREVIOUS_RELEASE:-}"; new_release="$DXDY_INSTALL_ROOT/releases/$latest"; rm -rf -- "$new_release"; mkdir -p "$temp/extract"; tar -xzf "$temp/$artifact" -C "$temp/extract"
  jq -e --arg v "$latest" --arg a "$DXDY_ARCH" --arg c "$(jq -er '.git_commit' "$temp/manifest.json")" '.version==$v and .release_model=="native-systemd" and .architecture==$a and .git_commit==$c' "$temp/extract/dx-dy-$latest-linux-$DXDY_ARCH/RELEASE.json" >/dev/null || die "Artifact release identity validation failed."
  cp -a "$temp/extract/dx-dy-$latest-linux-$DXDY_ARCH" "$new_release"
  if [[ "${DXDY_ALLOW_TEST_PATHS:-0}" != 1 ]]; then
    chown -R root:root "$new_release"; chmod -R a-w "$new_release"
  fi
  write_update_state prepared "$old_release" "$new_release" "$backup" "$backup_fingerprint" "$old_version" "$latest" "$old_previous" "$caddy_backup" "$caddy_fingerprint"
  systemctl stop "$SERVICE"; ln -sfn "releases/$latest" "$DXDY_INSTALL_ROOT/current.next"; mv -Tf "$DXDY_INSTALL_ROOT/current.next" "$CURRENT_LINK"
  set_config_value "$CONFIG_FILE" DXDY_PREVIOUS_RELEASE "$old_release"; set_config_value "$CONFIG_FILE" DXDY_VERSION "$latest"
  install -m 0644 "$new_release/dx-dy.service" "$SYSTEMD_UNIT_PATH"; systemctl daemon-reload
  write_update_state switched "$old_release" "$new_release" "$backup" "$backup_fingerprint" "$old_version" "$latest" "$old_previous" "$caddy_backup" "$caddy_fingerprint"
  systemctl start "$SERVICE" || result=$?
  [[ $result -eq 0 ]] && wait_health || result=1
  [[ $result -eq 0 ]] && reconcile_caddy "$new_release" "$caddy_backup" "$caddy_fingerprint" || result=1
  if [[ $result -ne 0 ]]; then
    systemctl stop "$SERVICE" || true; ln -sfn "$old_release" "$DXDY_INSTALL_ROOT/current.next"; mv -Tf "$DXDY_INSTALL_ROOT/current.next" "$CURRENT_LINK"
    set_config_value "$CONFIG_FILE" DXDY_VERSION "$old_version"; set_config_value "$CONFIG_FILE" DXDY_PREVIOUS_RELEASE "$old_previous"
    install -m 0644 "$old_release/dx-dy.service" "$SYSTEMD_UNIT_PATH"; systemctl daemon-reload
    if ! restore_update_backup "$backup" "$backup_fingerprint"; then
      die "ROLLBACK: FAIL; database recovery failed. Application remains stopped; backups and failed database retained."
    fi
    if ! restore_caddy_fragment "$caddy_backup" "$caddy_fingerprint"; then
      die "ROLLBACK: FAIL; database recovered but previous Caddy configuration could not be restored. Application remains stopped."
    fi
    if ! systemctl start "$SERVICE" || ! wait_health; then
      die "ROLLBACK: FAIL; previous database restored but application is not healthy."
    fi
    rm -f "$UPDATE_STATE_FILE"
    printf 'ROLLBACK: PASS\n'
    die "Update failed; previous release and database were restored."
  fi
  install -m 0755 "$temp/dx-dy" "$MANAGER_PATH.next"; mv -f "$MANAGER_PATH.next" "$MANAGER_PATH"; rm -f "$UPDATE_STATE_FILE"; prune_releases
  printf 'Updated to dx-dy %s.\nROLLBACK: NOT REQUIRED\n' "$latest"
}

cmd_cleanup_legacy() {
  require_root; load_instance
  [[ -n "${DXDY_LEGACY_ROOT:-}" ]] || die "No retained legacy installation is recorded."
  printf 'This removes only the retained dx-dy Docker stack. Type CLEANUP to continue: '
  local answer; read -r answer; [[ "$answer" == CLEANUP ]] || die "Confirmation did not match."
  [[ -f "$DXDY_LEGACY_ROOT/docker-compose.yml" ]] || die "Legacy Compose file not found."
  docker compose -f "$DXDY_LEGACY_ROOT/docker-compose.yml" down
  printf 'Legacy containers stopped and removed. Docker Engine and images were preserved.\n'
}

safe_remove_tree() {
  local target="$1"
  [[ "$target" == /opt/dx-dy || "$target" == /etc/dx-dy || "$target" == /var/lib/dx-dy || "$target" == /var/backups/dx-dy || ( "${DXDY_ALLOW_TEST_PATHS:-0}" == 1 && "$target" == /tmp/dxdy-ops-test-* ) ]] || die "Refusing unexpected removal path: $target"
  rm -rf -- "$target"
}
remove_caddy_import() {
  local import_line="import $CADDY_IMPORT" temp
  [[ -f "$CADDY_MAIN" ]] || return 0
  temp="$(mktemp "${CADDY_MAIN}.XXXXXX")"
  awk -v line="$import_line" '$0 != line { print }' "$CADDY_MAIN" >"$temp"
  chmod --reference="$CADDY_MAIN" "$temp"
  chown --reference="$CADDY_MAIN" "$temp"
  mv -f "$temp" "$CADDY_MAIN"
}
cmd_uninstall() {
  require_root; load_instance
  printf '1. Uninstall program; preserve config, database and backups\n2. Full purge\n0. Cancel\n'
  local choice confirmation; read -r -p "Choice: " choice
  case "$choice" in
    1) systemctl disable --now "$SERVICE" || true; remove_caddy_import; rm -f "$SYSTEMD_UNIT_PATH" "$CADDY_IMPORT" "$MANAGER_PATH"; safe_remove_tree "$DXDY_INSTALL_ROOT"; systemctl daemon-reload; systemctl reload caddy.service || true; printf 'Program removed; config, database and backups preserved. Caddy was not uninstalled.\n' ;;
    2) read -r -p 'Type DELETE to continue: ' confirmation; [[ "$confirmation" == DELETE ]] || die "Confirmation did not match."; systemctl disable --now "$SERVICE" || true; remove_caddy_import; rm -f "$SYSTEMD_UNIT_PATH" "$CADDY_IMPORT" "$MANAGER_PATH"; safe_remove_tree "$DXDY_INSTALL_ROOT"; safe_remove_tree "$CONFIG_DIR"; safe_remove_tree "$DXDY_DATA_DIR"; safe_remove_tree "$DXDY_BACKUP_DIR"; systemctl daemon-reload; systemctl reload caddy.service || true; printf 'dx-dy and all instance data removed. Caddy was not uninstalled.\n' ;;
    0) return ;; *) die "Invalid choice." ;;
  esac
}

show_help() {
  cat <<'EOF'
dx-dy - Private Node & Subscription Manager

Usage: dx-dy [command]
  status | start | stop | restart | update
  admin <reset-password|change-username>
  domain [set-admin HOST|set-subscription HOST|single|dual HOST|check]
  backup <db|full> | migrate | restore [ABSOLUTE_PATH]
  logs [app|caddy|all|follow] [lines]
  doctor | cleanup-legacy | version | uninstall | --help
EOF
}
menu() {
  while true; do
    printf '\ndx-dy %s - Native systemd management\n1. Status\n2. Start\n3. Stop application\n4. Restart\n5. Update\n6. Reset admin password\n7. Change admin username\n8. Domain management\n9. Doctor\n10. Database backup\n11. Full migration backup\n12. Restore\n13. Logs\n14. Uninstall\n0. Exit\n' "$DXDY_MANAGER_VERSION"
    local choice; read -r -p "Choice: " choice
    case "$choice" in 1) cmd_status ;; 2) require_root; cmd_start ;; 3) require_root; cmd_stop ;; 4) require_root; cmd_restart ;; 5) cmd_update ;; 6) require_root; cmd_admin reset-password ;; 7) require_root; cmd_admin change-username ;; 8) cmd_domain menu ;; 9) cmd_doctor ;; 10) require_root; cmd_backup db ;; 11) require_root; cmd_backup full ;; 12) cmd_restore ;; 13) cmd_logs app 200 ;; 14) cmd_uninstall; return ;; 0) return ;; *) warn "Invalid choice." ;; esac
  done
}

case "${1:-}" in
  "") menu ;; status) cmd_status ;; start) require_root; cmd_start ;; stop) require_root; cmd_stop ;; restart) require_root; cmd_restart ;; update) cmd_update ;;
  admin) require_root; shift; cmd_admin "$@" ;; domain) shift; cmd_domain "$@" ;; backup) require_root; shift; cmd_backup "$@" ;; migrate) require_root; cmd_backup full ;; restore) shift; cmd_restore "$@" ;; logs) shift; cmd_logs "$@" ;; doctor) cmd_doctor ;; cleanup-legacy) cmd_cleanup_legacy ;; version) printf 'dx-dy %s\n' "$DXDY_MANAGER_VERSION" ;; uninstall) cmd_uninstall ;; -h|--help|help) show_help ;; *) die "Unknown command. Run dx-dy --help." ;;
esac
