DXDY_VERSION=0.3.8
DXDY_REPOSITORY=torr9522/dx-dy
DXDY_INSTALL_CHANNEL=stable
DXDY_INSTALL_ROOT=/opt/dx-dy
DXDY_CONFIG_DIR=/etc/dx-dy
DXDY_DATA_DIR=/var/lib/dx-dy
DXDY_BACKUP_DIR=/var/backups/dx-dy
DXDY_INTERNAL_PORT=3000
DXDY_ADMIN_DOMAIN=panel.example.com
DXDY_SUBSCRIPTION_DOMAIN=sub.example.com
DXDY_CADDY_IMPORT=/etc/caddy/dx-dy.caddy
DXDY_CADDYFILE=/etc/caddy/Caddyfile
DXDY_CADDY_ADAPTER=caddyfile
DXDY_CADDY_BINARY=/usr/bin/caddy
DXDY_SERVICE=dx-dy.service
DXDY_ARCH=amd64
DXDY_PREVIOUS_RELEASE=
DXDY_LEGACY_ROOT=
