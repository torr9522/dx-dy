__ADMIN_DOMAIN__ {
	log {
		output discard
	}
	@compressible not path /s/* /smart/* /client/*
	encode @compressible zstd gzip
	reverse_proxy app:3000
}

__SUBSCRIPTION_DOMAIN__ {
	log {
		output discard
	}
	@subscription path /s/* /smart/* /client/* /health
	handle @subscription {
		reverse_proxy app:3000
	}
	respond 404
}
