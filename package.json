{
  "name": "private-subscription-manager",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "26.10.x"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "adapter:build": "node scripts/build-adapter.mjs",
    "dev": "tsx apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "lint": "eslint apps packages tests",
    "typecheck": "tsc --noEmit",
    "test": "pnpm adapter:build && vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm adapter:build && vite build --config apps/web/vite.config.ts && esbuild apps/api/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs && esbuild scripts/backup.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/backup.mjs && node scripts/source.mjs",
    "start": "node dist/server.mjs",
    "backup": "tsx scripts/backup.ts",
    "source:manifest": "node scripts/update-source-manifest.mjs",
    "source:archive": "node scripts/source.mjs",
    "source:verify": "node scripts/verify-source.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.2.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ip-address": "^10.7.3",
    "js-base64": "^3.9.4",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "lucide-react": "^1.52.0",
    "peggy": "2.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "3.8.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
